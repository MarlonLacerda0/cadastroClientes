@model IEnumerable<cadastroClientes.Models.Cliente>

<table class="table">
    <thead class="thead-dark">
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Telefone</th>
            <th scope="col">CPF</th>
            <th scope="col">Email</th>
            <th scope="col">Data Cadastro</th>
            <th scope="col">Editar</th>
            <th scope="col">Excluir</th>
        </tr>
    </thead>
    <tbody>

    @{
        foreach (var cliente in Model)
        {
                <tr>
                    <td>@cliente.Nome</td>
                    <td>@cliente.Telefone</td>
                    <td>@cliente.CPF</td>
                    <td>@cliente.Email</td>
                    <td>@cliente.DatCadastro.ToString("dd/MM/yyyy")</td>
                    <td><button onclick="ModalEdicao(@cliente.Id)" type="button">E</button></td>
                    <td><button class="text-danger" onclick="ExcluirCliente(@cliente.CPF)" type="button">X</button></td>
                </tr>
     
        }
    }
           </tbody>
</table>

