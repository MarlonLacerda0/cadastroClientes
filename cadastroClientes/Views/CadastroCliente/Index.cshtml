@{
    ViewData["Title"] = "Cadastro Cliente";
}
<form id="formCadastro">
    <h1>Cadastro Cliente</h1>
    <div class="form-row">
        <div class="form-group col-md-4">
            <label for="Nome">Nome</label>
            <input type="text" class="form-control" id="Nome" name="Nome" placeholder="Digite o nome">
        </div>

        <div class="form-group col-md-4">
            <label for="Email">Email</label>
            <input type="email" class="form-control" id="Email" name="Email" placeholder="Digite o email">
        </div>
    </div>

    <div class="form-row">
        <div class="form-group col-md-2">
            <label for="CPF">CPF</label>
            <input type="text" class="form-control" id="CPF" name="CPF" placeholder="000.000.000-00">
        </div>

        <div class="form-group col-md-2">
            <label for="Telefone">Telefone</label>
            <input type="text" class="form-control" id="Telefone" name="Telefone" placeholder="(00) 00000-0000">
        </div>

        <div class="form-group col-md-2">
            <label for="DatNascimento">Data de Nascimento</label>
            <input type="date" class="form-control" id="DatNascimento" name="DatNascimento">
        </div>
@* 
        <div class="form-group col-md-2">
            <label for="DatCadastro">Data de Cadastro</label>
            <input type="date" class="form-control" id="DatCadastro" name="DatCadastro">
        </div> *@
    </div>


    <button type="button" onclick="CadastrarCliente()" class="btn btn-primary mt-5">Cadastrar</button>
</form>
@section Scripts {
    <script src="~/js/cadastroCliente.js"></script>
}